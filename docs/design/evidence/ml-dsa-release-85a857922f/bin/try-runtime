#!/usr/bin/env python3
"""Preserve case-sensitive Wasm bytes for try-runtime 0.10.1's path parser."""
import hashlib, json, os, shutil, sys
from pathlib import Path
n=Path('/tmp/ms-release-85a857922f')
args=sys.argv[1:]
if '--runtime' in args:
    index=args.index('--runtime')+1
    source=Path(args[index])
    if source.is_file():
        checksum=hashlib.sha256(source.read_bytes()).hexdigest()
        target=n/'preflight-runtime'/f'{checksum}.wasm'
        target.parent.mkdir(exist_ok=True)
        shutil.copyfile(source,target)
        assert hashlib.sha256(target.read_bytes()).hexdigest()==checksum
        (n/'preflight-path-workaround.json').write_text(json.dumps({'reason':'try-runtime 0.10.1 lowercases the runtime argument, including Desktop','source':str(source),'copied_to':str(target),'sha256':checksum,'argument_changes':'Only the --runtime path; exact bytes verified; every check flag preserved','tool_sha256':hashlib.sha256(Path('/tmp/ms-release-483b52ceea/mainnet/try-runtime').read_bytes()).hexdigest()},indent=2)+'\n')
        args[index]=str(target)
os.execv('/tmp/ms-release-483b52ceea/mainnet/try-runtime',['/tmp/ms-release-483b52ceea/mainnet/try-runtime',*args])
